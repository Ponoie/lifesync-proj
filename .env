# MongoDB Connection
# สำหรับ Docker (เลือกอันใดอันนึง):

# 1. ใช้กับ docker-compose (แนะนำ ⭐)
MONGODB_URI=mongodb://admin:password123@mongodb:27017/lifesync?authSource=admin

# 2. ถ้ารันแยก (MongoDB เปิดเองที่เครื่อง)
# MONGODB_URI=mongodb://localhost:27017/lifesync

# 3. ถ้าใช้ MongoDB Atlas
# MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/lifesync?retryWrites=true&w=majority

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5174
