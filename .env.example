# MongoDB Connection
# ใส่ connection string ของคุณตรงนี้
MONGODB_URI=mongodb://localhost:27017/lifesync

# หรือใช้ MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/lifesync?retryWrites=true&w=majority

# Server
PORT=3001
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:5174
